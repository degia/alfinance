#!/usr/bin/env bash
# Auto-deploy setelah `git pull` / `git merge`.
# Diaktifkan oleh: git config core.hooksPath scripts/git-hooks  (lihat scripts/setup-deploy.sh)
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$ROOT" ] && [ -x "$ROOT/scripts/deploy.sh" ] || exit 0
# hanya jalan di mesin yang menjalankan container production
[ -n "$(docker ps --format '{{.Names}}' 2>/dev/null | grep -Fx alfinance_app)" ] || exit 0
"$ROOT/scripts/deploy.sh" >> "$ROOT/storage/logs/deploy.log" 2>&1 \
    || echo "[deploy] GAGAL → cek storage/logs/deploy.log" >&2
